# Copy to .env. VS Code loads this file for run and debug configurations.
# Defaults work without any of these set: SQLite, eager Celery, no Redis.

DJANGO_SECRET_KEY=change-me-for-anything-beyond-local-debugging
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database: sqlite (default) or postgres (needs docker compose up -d).
PREFKIT_DB=sqlite
# POSTGRES_DB=prefkit
# POSTGRES_USER=prefkit
# POSTGRES_PASSWORD=prefkit
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Celery: 1 runs tasks in this process (good for debugging). 0 sends them to Redis.
PREFKIT_EAGER=1
# REDIS_URL=redis://localhost:6379/0

# Compute: auto | cuda | mps | cpu
PREFKIT_DEVICE=auto
PREFKIT_JUDGE_MODEL=Qwen/Qwen2.5-3B-Instruct
PREFKIT_LOG_LEVEL=INFO
